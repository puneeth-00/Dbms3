<%- include('partials/header') %>

<% if (error) { %>
    <div class="alert alert-danger">
        <span>⚠️ <strong>Error:</strong> <%= error %></span>
    </div>
<% } %>

<% if (success) { %>
    <div class="alert alert-success">
        <span>✅ <%= success %></span>
    </div>
<% } %>

<div class="section-header">
    <div>
        <h2 class="section-title">🏛️ Registrar Office & Academic Administration</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Review student requests, execute stored procedures to formally generate certificates, and track audit logs.</p>
    </div>
</div>

<!-- Pending Requests Section -->
<div class="card">
    <div class="section-header">
        <div>
            <h3 class="section-title" style="font-size: 1.25rem;">Requests Awaiting Action</h3>
            <p style="color: var(--text-muted); font-size: 0.85rem;">
                Approving a request invokes PostgreSQL Stored Procedure <code>sp_approve_and_issue_certificate</code>.
            </p>
        </div>
        <span class="badge badge-pending"><%= pendingRequests.length %> Actionable</span>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Req #</th>
                    <th>Student Details</th>
                    <th>Certificate Requested</th>
                    <th>Purpose</th>
                    <th>Date</th>
                    <th>Execute Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (pendingRequests.length === 0) { %>
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                            🎉 All pending requests have been processed!
                        </td>
                    </tr>
                <% } %>
                <% pendingRequests.forEach(r => { %>
                    <tr>
                        <td><strong>#<%= r.request_id %></strong></td>
                        <td>
                            <strong><%= r.full_name %></strong><br>
                            <code><%= r.reg_number %></code> &bull; <small><%= r.dept_name %></small>
                        </td>
                        <td>
                            <strong><%= r.cert_title %></strong><br>
                            <span style="font-size: 0.8rem; color: var(--text-muted);">Fee: ₹<%= parseFloat(r.processing_fee).toFixed(2) %></span>
                        </td>
                        <td style="max-width: 250px; font-size: 0.85rem;"><%= r.purpose %></td>
                        <td><%= new Date(r.requested_at).toLocaleDateString() %></td>
                        <td>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <!-- Form to call Stored Procedure sp_approve_and_issue_certificate -->
                                <form action="/admin/approve" method="POST" style="display: inline;">
                                    <input type="hidden" name="request_id" value="<%= r.request_id %>">
                                    <input type="hidden" name="officer_name" value="Registrar Dr. K. Rao">
                                    <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Execute stored procedure to approve and issue certificate #<%= r.request_id %>?')">
                                        ⚡ Approve & Issue
                                    </button>
                                </form>

                                <!-- Form to call Stored Procedure sp_reject_request -->
                                <form action="/admin/reject" method="POST" style="display: inline;">
                                    <input type="hidden" name="request_id" value="<%= r.request_id %>">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to reject request #<%= r.request_id %>?')">
                                        ✕ Reject
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Issued Certificates Table -->
<div class="card">
    <div class="section-header">
        <div>
            <h3 class="section-title" style="font-size: 1.25rem;">Issued Verifiable Certificates</h3>
            <p style="color: var(--text-muted); font-size: 0.85rem;">Generated by stored procedure with cryptographic checksums.</p>
        </div>
        <span class="badge badge-issued"><%= issuedCerts.length %> Issued</span>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Certificate Number</th>
                    <th>Student Name & Reg</th>
                    <th>Certificate Type</th>
                    <th>Issued By</th>
                    <th>Issue Date</th>
                    <th>Verification Hash</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (issuedCerts.length === 0) { %>
                    <tr>
                        <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">No certificates issued yet.</td>
                    </tr>
                <% } %>
                <% issuedCerts.forEach(c => { %>
                    <tr>
                        <td><code><strong><%= c.cert_number %></strong></code></td>
                        <td>
                            <strong><%= c.full_name %></strong><br>
                            <code><%= c.reg_number %></code>
                        </td>
                        <td><%= c.cert_title %></td>
                        <td><small><%= c.issued_by %></small></td>
                        <td><%= new Date(c.issue_date).toLocaleDateString() %></td>
                        <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <code style="font-size: 0.75rem;" title="<%= c.verification_hash %>"><%= c.verification_hash %></code>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.35rem;">
                                <a href="/certificate/<%= c.request_id %>" class="btn btn-outline btn-sm">
                                    📜 View
                                </a>
                                <a href="/verify?cert=<%= c.cert_number %>" class="btn btn-success btn-sm">
                                    🔍 Verify
                                </a>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('partials/footer') %>
