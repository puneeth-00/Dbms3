<%- include('partials/header') %>

<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
    <a href="/students" class="btn btn-outline">&larr; Back to Student Portal</a>
    <button onclick="window.print()" class="btn btn-primary">🖨️ Print / Save as PDF</button>
</div>

<div class="certificate-frame">
    <div class="cert-header">
        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🏛️</div>
        <div class="cert-institution">University of Engineering & Technology</div>
        <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.25rem;">Accredited Autonomous Institution &bull; Office of the Registrar</div>
    </div>

    <div class="cert-title">Official Certificate of Verification</div>

    <div class="cert-body">
        This is to formally certify that
        <div class="cert-recipient"><%= cert.full_name %></div>
        bearing University Registration Number <strong><code><%= cert.reg_number %></code></strong>, 
        student of the <strong><%= cert.dept_name %></strong>, has been officially awarded the credential:
        <br><br>
        <span style="font-size: 1.4rem; font-weight: 700; color: #1e3a8a;"><%= cert.cert_title %></span>
        <br><br>
        Issued upon fulfillment of all institutional requirements and regulations.
    </div>

    <div class="cert-footer">
        <div style="text-align: left;">
            <div style="font-size: 0.85rem; color: #64748b;">Date of Issue</div>
            <div style="font-weight: 700;"><%= new Date(cert.issue_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
            <div style="margin-top: 0.5rem; font-size: 0.85rem; color: #64748b;">Certificate No.</div>
            <div><code><%= cert.cert_number %></code></div>
        </div>

        <div style="text-align: center;">
            <div style="display: inline-block; border: 2px dashed #059669; padding: 0.5rem 1rem; border-radius: 8px; color: #059669; font-weight: 700; font-size: 0.85rem;">
                ✔ DIGITALLY VERIFIED
            </div>
        </div>

        <div style="text-align: right;">
            <div style="font-size: 0.95rem; font-weight: 700; color: #1e293b;"><%= cert.issued_by %></div>
            <div style="font-size: 0.8rem; color: #64748b;">Authorized Signatory</div>
        </div>
    </div>

    <div style="margin-top: 2rem; text-align: left;">
        <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Cryptographic Verification Fingerprint (SHA256):</span>
        <div class="cert-hash"><%= cert.verification_hash %></div>
    </div>
</div>

<%- include('partials/footer') %>
